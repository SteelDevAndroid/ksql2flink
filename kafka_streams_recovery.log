Name                 : ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL
Type                 : STREAM
Timestamp field      : Not set - using <ROWTIME>
Key format           : KAFKA
Value format         : JSON
Kafka topic          : asf.peage.suiviconso.comptage.bol (partitions: 6, replication: 4)
Statement            : CREATE OR REPLACE STREAM ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL WITH (CLEANUP_POLICY='delete', KAFKA_TOPIC='asf.peage.suiviconso.comptage.bol', KEY_FORMAT='KAFKA', PARTITIONS=6, REPLICAS=4, RETENTION_MS=604800000, VALUE_FORMAT='JSON') AS SELECT
  ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`message`->DHM `DateMessage`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`comptageBols`->`localisation`->`gare` `IdGare`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`comptageBols`->`localisation`->`equipement`->`numero` `Voie`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`comptageBols`->`dhm` `DateComptage`,
  (CASE WHEN (ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`contenu`->`valeur` = 0.1) THEN 9 WHEN (ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`contenu`->`valeur` = 0.2) THEN 10 WHEN (ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`contenu`->`valeur` = 0.5) THEN 11 WHEN (ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`contenu`->`valeur` = 1) THEN 12 WHEN (ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`contenu`->`valeur` = 2) THEN 13 ELSE CAST(ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`contenu`->`valeur` AS INTEGER) END) `Position`,
  SPLIT(ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`sujet`, '.')[2] `Numero`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`contenu`->`type` `Type`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`contenu`->`devise` `Devise`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`contenu`->`courant` `Valeur`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`contenu`->`maximum` `Capacite`
FROM ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED
WHERE ((ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`Etat`->`contenu`->`type` = 'piece') AND (ASF_PEAGE_SUIVICONSO_COMPTAGE_BOL_EXPLODED.`comptageBols`->`localisation`->`gare` LIKE '25004%'))
EMIT CHANGES;

