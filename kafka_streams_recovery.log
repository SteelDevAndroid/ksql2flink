Kafka topic          : esc.peage.suiviconso.comptage.coffre (partitions: 6, replication: 4)
Statement            : CREATE OR REPLACE STREAM ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE WITH (CLEANUP_POLICY='delete', KAFKA_TOPIC='esc.peage.suiviconso.comptage.coffre', KEY_FORMAT='KAFKA', PARTITIONS=6, REPLICAS=4, RETENTION_MS=604800000, VALUE_FORMAT='JSON') AS SELECT
  ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`message`->DHM `DateMessage`,
  ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`localisation`->`gare` `IdGare`,
  ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`localisation`->`equipement`->`numero` `Voie`,
  ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`dhm` `DateComptage`,
  (CASE WHEN (ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` = 0) THEN 15 WHEN ((ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` = 1) AND (ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`type` = 'piece')) THEN 7 WHEN ((ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` = 1) AND (ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`type` = 'billet')) THEN 16 WHEN (ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` = 2) THEN 8 WHEN (ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` = 5) THEN 14 ELSE ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` END) `Position`,
  ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`type` `Type`,
  ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`type` `TypeEspece`,
  ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`capacite`->`valeur` `ValeurCapacite`,
  ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`capacite`->`unite` `UniteCapacite`,
  ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`courant`->`valeur` `ValeurCourant`,
  ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`courant`->`unite` `UniteCourant`
FROM ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE
WHERE (((ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`type` = 'sac') OR (ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`type` = 'coffre')) AND (ESC_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`localisation`->`gare` LIKE '25006%'))
EMIT CHANGES;

