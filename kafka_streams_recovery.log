Statement            : CREATE OR REPLACE STREAM ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE WITH (CLEANUP_POLICY='delete', KAFKA_TOPIC='asf.peage.suiviconso.comptage.coffre', KEY_FORMAT='KAFKA', PARTITIONS=6, REPLICAS=4, RETENTION_MS=604800000, VALUE_FORMAT='JSON') AS SELECT
  ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`message`->DHM `DateMessage`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`localisation`->`gare` `IdGare`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`localisation`->`equipement`->`numero` `Voie`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`dhm` `DateComptage`,
  (CASE WHEN (ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` = 0) THEN 15 WHEN ((ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` = 1) AND (ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`type` = 'piece')) THEN 7 WHEN ((ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` = 1) AND (ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`type` = 'billet')) THEN 16 WHEN (ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` = 2) THEN 8 WHEN (ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` = 5) THEN 14 ELSE ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`position` END) `Position`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`type` `Type`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`type` `TypeEspece`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`capacite`->`valeur` `ValeurCapacite`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`capacite`->`unite` `UniteCapacite`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`courant`->`valeur` `ValeurCourant`,
  ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`contenu`->`courant`->`unite` `UniteCourant`
FROM ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE
WHERE (((ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`type` = 'sac') OR (ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`type` = 'coffre')) AND (ASF_PEAGE_SUIVICONSO_COMPTAGE_COFFRE_BASE.`comptageCoffre`->`localisation`->`gare` LIKE '25004%'))
EMIT CHANGES;

