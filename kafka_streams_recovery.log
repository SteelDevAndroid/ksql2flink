 DateComptage | VARCHAR(STRING) 
 Position     | INTEGER         
 Numero       | VARCHAR(STRING) 
 Type         | VARCHAR(STRING) 
 Devise       | VARCHAR(STRING) 
 Valeur       | INTEGER         
 Capacite     | INTEGER         


