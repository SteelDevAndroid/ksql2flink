Name                 : ASF_PEAGE_LEXVA_PASSAGESORTIEVA_LEXHISTORIC_STREAM
Type                 : STREAM
Timestamp field      : Not set - using <ROWTIME>
Key format           : KAFKA
Value format         : JSON
Kafka topic          : va.peage.voie.passagesortieva.lexhistoric (partitions: 2, replication: 4)
Statement            : CREATE OR REPLACE STREAM ASF_PEAGE_LEXVA_PASSAGESORTIEVA_LEXHISTORIC_STREAM WITH (CLEANUP_POLICY='delete', KAFKA_TOPIC='va.peage.voie.passagesortieva.lexhistoric', PARTITIONS=2, REPLICAS=4, RETENTION_MS=86400000, VALUE_FORMAT='json') AS SELECT
  ASF_PEAGE_VOIE_PASSAGESORTIEVA_STREAM.IDPASSAGE IDTRAN,
  ASF_PEAGE_VOIE_PASSAGESORTIEVA_STREAM.PASSAGESORTIE->DHM DATETRANSACTION,
  ASF_PEAGE_VOIE_PASSAGESORTIEVA_STREAM.PASSAGESORTIE->PAIEMENT->RETENUS[1]->PAN CONTENUISO,
  (CASE WHEN (LCASE(ASF_PEAGE_VOIE_PASSAGESORTIEVA_STREAM.PASSAGESORTIE->PAIEMENT->RETENUS[1]->TYPE) = 'telepeagelibert') THEN 256 WHEN (LCASE(ASF_PEAGE_VOIE_PASSAGESORTIEVA_STREAM.PASSAGESORTIE->PAIEMENT->RETENUS[1]->TYPE) = 'telepeagecardme') THEN 512 WHEN (LCASE(ASF_PEAGE_VOIE_PASSAGESORTIEVA_STREAM.PASSAGESORTIE->PAIEMENT->RETENUS[1]->TYPE) = 'carteaccreditive') THEN 1024 WHEN (LCASE(ASF_PEAGE_VOIE_PASSAGESORTIEVA_STREAM.PASSAGESORTIE->PAIEMENT->RETENUS[1]->TYPE) = 'cartemagnetique') THEN 2048 ELSE 0 END) MODEREGLEMENT,
  SUBSTRING(ASF_PEAGE_VOIE_PASSAGESORTIEVA_STREAM.PASSAGESORTIE->LOCALISATION->GARE, 1, 5) SCA
FROM ASF_PEAGE_VOIE_PASSAGESORTIEVA_STREAM ASF_PEAGE_VOIE_PASSAGESORTIEVA_STREAM
WHERE (LCASE(ASF_PEAGE_VOIE_PASSAGESORTIEVA_STREAM.PASSAGESORTIE->PAIEMENT->RETENUS[1]->TYPE) IN ('telepeagelibert', 'telepeagecardme', 'carteaccreditive', 'cartemagnetique'))
EMIT CHANGES;

 Field           | Type            

 IDTRAN          | VARCHAR(STRING) 
 DATETRANSACTION | VARCHAR(STRING) 
 CONTENUISO      | VARCHAR(STRING) 
 MODEREGLEMENT   | INTEGER         
 SCA             | VARCHAR(STRING) 


